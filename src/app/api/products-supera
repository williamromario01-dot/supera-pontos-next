import { NextRequest, NextResponse } from "next/server";
import { ObjectId } from "mongodb";
import clientPromise from "@/lib/mongodb";

async function getAuthenticatedUser(request: NextRequest) {
  const token = request.cookies.get("supera_session")?.value;

  if (!token) {
    return null;
  }

  const client = await clientPromise;
  const db = client.db("supera_pontos");

  const session = await db.collection("sessions").findOne({
    token,
    expiresAt: { $gt: new Date() },
  });

  if (!session) {
    return null;
  }

  const user = await db.collection("users").findOne({
    _id: session.userId,
  });

  if (!user || user.active === false) {
    return null;
  }

  return user;
}

export async function GET(request: NextRequest) {
  try {
    const user = await getAuthenticatedUser(request);

    if (!user) {
      return NextResponse.json(
        { error: "Não autorizado." },
        { status: 401 }
      );
    }

    const client = await clientPromise;
    const db = client.db("supera_pontos");

    const query: Record<string, unknown> = {
      active: true,
    };

    if (user.role !== "super_admin") {
      if (!user.schoolId) {
        return NextResponse.json(
          {
            error:
              "Usuário não está vinculado a uma escola.",
          },
          { status: 403 }
        );
      }

      query.schoolId = user.schoolId;
    }

    const products = await db
      .collection("superaProducts")
      .find(query)
      .sort({ createdAt: -1 })
      .toArray();

    return NextResponse.json(
      products.map((product) => ({
        id: product._id.toString(),
        schoolId: product.schoolId,
        name: product.name,
        description: product.description || "",
        image: product.image || "",
        price: product.price,
        stock: product.stock,
        active: product.active,
        createdAt: product.createdAt,
        updatedAt: product.updatedAt,
      }))
    );
  } catch (error) {
    console.error(
      "Erro ao carregar Produtos Supera:",
      error
    );

    return NextResponse.json(
      {
        error:
          "Erro interno ao carregar os produtos.",
      },
      { status: 500 }
    );
  }
}

export async function POST(request: NextRequest) {
  try {
    const user = await getAuthenticatedUser(request);

    if (!user) {
      return NextResponse.json(
        { error: "Não autorizado." },
        { status: 401 }
      );
    }

    if (
      user.role !== "super_admin" &&
      user.role !== "admin" &&
      user.role !== "educator"
    ) {
      return NextResponse.json(
        {
          error:
            "Você não tem permissão para cadastrar produtos.",
        },
        { status: 403 }
      );
    }

    const body = await request.json();

    const name = String(body.name || "").trim();
    const description = String(
      body.description || ""
    ).trim();
    const image = String(body.image || "").trim();

    const price = Number(body.price);
    const stock = Number(body.stock);

    if (!name) {
      return NextResponse.json(
        {
          error:
            "O nome do produto é obrigatório.",
        },
        { status: 400 }
      );
    }

    if (name.length > 100) {
      return NextResponse.json(
        {
          error:
            "O nome do produto deve ter no máximo 100 caracteres.",
        },
        { status: 400 }
      );
    }

    if (description.length > 500) {
      return NextResponse.json(
        {
          error:
            "A descrição deve ter no máximo 500 caracteres.",
        },
        { status: 400 }
      );
    }

    if (
      !Number.isFinite(price) ||
      price <= 0 ||
      price > 1000000
    ) {
      return NextResponse.json(
        {
          error:
            "O preço do produto é inválido.",
        },
        { status: 400 }
      );
    }

    if (
      !Number.isInteger(stock) ||
      stock < 0 ||
      stock > 1000000
    ) {
      return NextResponse.json(
        {
          error: "O estoque é inválido.",
        },
        { status: 400 }
      );
    }

    const client = await clientPromise;
    const db = client.db("supera_pontos");

    let schoolId: string | null = null;

    if (user.role === "super_admin") {
      schoolId = body.schoolId
        ? String(body.schoolId).trim()
        : null;

      if (
        schoolId &&
        !ObjectId.isValid(schoolId)
      ) {
        return NextResponse.json(
          {
            error: "Escola inválida.",
          },
          { status: 400 }
        );
      }
    } else {
      if (!user.schoolId) {
        return NextResponse.json(
          {
            error:
              "Usuário não está vinculado a uma escola.",
          },
          { status: 403 }
        );
      }

      schoolId = user.schoolId;
    }

    if (!schoolId) {
      return NextResponse.json(
        {
          error:
            "A escola do produto é obrigatória.",
        },
        { status: 400 }
      );
    }

    const school = await db
      .collection("schools")
      .findOne({
        _id: new ObjectId(schoolId),
      });

    if (!school) {
      return NextResponse.json(
        {
          error: "Escola não encontrada.",
        },
        { status: 404 }
      );
    }

    const escapedName = name.replace(
      /[.*+?^${}()|[\]\\]/g,
      "\\$&"
    );

    const existingProduct = await db
      .collection("superaProducts")
      .findOne({
        schoolId,
        name: {
          $regex: `^${escapedName}$`,
          $options: "i",
        },
      });

    if (existingProduct) {
      return NextResponse.json(
        {
          error:
            "Já existe um produto com esse nome nesta escola.",
        },
        { status: 409 }
      );
    }

    const now = new Date();

    const product = {
      schoolId,
      name,
      description,
      image,
      price: Number(price.toFixed(2)),
      stock,
      active: true,
      createdBy: user._id,
      createdAt: now,
      updatedAt: now,
    };

    const result = await db
      .collection("superaProducts")
      .insertOne(product);

    return NextResponse.json(
      {
        message:
          "Produto cadastrado com sucesso.",
        product: {
          id: result.insertedId.toString(),
          schoolId: product.schoolId,
          name: product.name,
          description: product.description,
          image: product.image,
          price: product.price,
          stock: product.stock,
          active: product.active,
          createdBy:
            user._id.toString(),
          createdAt: product.createdAt,
          updatedAt: product.updatedAt,
        },
      },
      { status: 201 }
    );
  } catch (error) {
    console.error(
      "Erro ao cadastrar Produto Supera:",
      error
    );

    return NextResponse.json(
      {
        error:
          "Erro interno ao cadastrar o produto.",
      },
      { status: 500 }
    );
  }
}
