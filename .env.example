# OBRIGATÓRIA EM PRODUÇÃO
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
APP_URL=https://superpontos.gfars.com.br
RESEND_API_KEY=
RESEND_FROM_EMAIL=DISPLAY_NAME <VERIFIED_SENDER@YOUR_DOMAIN>

# FINANCEIRO — manter sandbox até autorização explícita posterior
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# SANDBOX ONLY — desabilitados por padrão
ENABLE_ADMIN_SETUP=false
ADMIN_SETUP_SECRET=
ENABLE_LEGACY_STUDENT_REGISTRATION=false
ENABLE_SANDBOX_RECOVERY_CAPTURE=false
SANDBOX_RECOVERY_CAPTURE_EMAIL=
SANDBOX_RECOVERY_CAPTURE_CNPJ=
SANDBOX_RECOVERY_CAPTURE_PATH=
ENABLE_SANDBOX_CUSTOMER_CREATION=false
SANDBOX_CUSTOMER_CREATION_COMPANY_ID=
SANDBOX_CUSTOMER_CREATION_EXTERNAL_REFERENCE=
SANDBOX_CUSTOMER_CREATION_SUBSCRIPTION_ID=
SANDBOX_CUSTOMER_CREATION_EXPIRES_AT=
ENABLE_SANDBOX_SUBSCRIPTION_CREATION=false
SANDBOX_SUBSCRIPTION_CREATION_COMPANY_ID=
SANDBOX_SUBSCRIPTION_CREATION_SUBSCRIPTION_ID=
SANDBOX_SUBSCRIPTION_CREATION_CUSTOMER_ID=
SANDBOX_SUBSCRIPTION_CREATION_EXTERNAL_REFERENCE=
SANDBOX_SUBSCRIPTION_CREATION_REQUESTED_MAX_UNITS=
SANDBOX_SUBSCRIPTION_CREATION_VALUE_CENTS=
SANDBOX_SUBSCRIPTION_CREATION_EXPIRES_AT=
